Options -MultiViews
RewriteEngine On

# ── CORS headers — allow faizalamfaizi.com and subdomains ────────────────────
SetEnvIf Origin "^https://(www\.)?faizalamfaizi\.com$" CORS_ORIGIN=$0
Header always set Access-Control-Allow-Origin "%{CORS_ORIGIN}e" env=CORS_ORIGIN
Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
Header always set Access-Control-Allow-Headers "Content-Type, Authorization, Accept"
Header always set Access-Control-Allow-Credentials "true"

# Handle OPTIONS preflight — return 204 immediately
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^ - [R=204,L]

# Forward all other requests to Node.js via Passenger
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [L]
